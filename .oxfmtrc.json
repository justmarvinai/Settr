{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "docs/**",
    "src/routeTree.gen.ts",
    "src/i18n/paraglide/**",
    "pnpm-lock.yaml",
    "public/**"
  ]
}
